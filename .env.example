# Use the same Google Web OAuth client ID in the browser and API.
# Authorize http://localhost:5173 in Google Cloud Console for local development.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Browser Maps key. Restrict by HTTP referrer and allow Maps JavaScript API,
# Places API (New), Routes API, and Geocoding API in the same Google Cloud project.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Maps map ID. The app uses Google's DEMO_MAP_ID for local testing.
VITE_GOOGLE_MAPS_MAP_ID=

# Production: set a random secret at least 32 characters long.
SESSION_SECRET=
# Comma-separated exact origins allowed to make API write requests.
APP_ORIGIN=http://localhost:5173
# Exact comma-separated tunnel hostnames accepted by Vite during development.
AVANTI_VITE_ALLOWED_HOSTS=
PORT=4000
# PostgreSQL API-server connection. Never prefix this with VITE_.
# Local example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/avanti
# Managed providers should use their TLS-enabled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional direct endpoint, used by the one-time SQLite transfer utility.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Optional Neon pooled URL for API runtime (also used as DATABASE_URL).
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Use true for TLS-required providers when sslmode=require is not in the URL.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Optional: used only by the one-time migration utility to choose a SQLite source file.
# DATABASE_PATH=data/avanti.sqlite
# For local Vite/Cloudflare proxying use loopback. In production, use the exact
# trusted proxy subnet or hop count for your hosting setup.
TRUST_PROXY=loopback
