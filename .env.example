# Use the same Google Web OAuth client ID in the browser and API.
# Authorize http://localhost:5173 in Google Cloud Console for local development.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Maps JavaScript API browser key. Restrict by HTTP referrer and enabled APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Google Maps map ID. The app uses Google's DEMO_MAP_ID for local testing.
VITE_GOOGLE_MAPS_MAP_ID=

# Production: set a random secret at least 32 characters long.
SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
PORT=4000
DATABASE_PATH=data/avanti.sqlite
# If deployed behind a trusted reverse proxy, set its hop count (often 1).
TRUST_PROXY=
